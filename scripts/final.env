# Settings of the competition run, sourced by scripts/infer.sh. Anything already set in the
# environment wins, so every line can be overridden from `docker run -e` or the shell.
#
# These mirror the best measured setup (2x RTX 5090, Qwen3.5-9B, one replica per GPU, thinking on
# with presence_penalty 1.5, k-sample vote with an agreement gate). The sample count and the gates
# below are UNTESTED defaults: run `make rerun-check` and a timing run, then edit them.
# Never put a secret here; the file is copied into the image.

_default() { [[ -z "${!1+set}" ]] && export "$1=$2"; return 0; }

# model and serving: one vLLM per GPU (scripts/infer.sh starts them), requests split by thread
_default LLM_MODEL "Qwen/Qwen3.5-9B"
_default REPLICAS 2
_default VLLM_BASE_PORT 8011
_default MAX_MODEL_LEN 40960
_default MAX_NUM_SEQS 16
# 14 question threads per replica (the pod runs used 14-16 per process)
_default WORKERS 28

# pipeline: MALT with thinking on every reasoning step
_default PIPELINE malt
_default ANALYZE_MAX_TOKENS 10240
_default FEW_SHOT_K 0
_default MIN_CONFIDENCE 0.05

# vote over k approaches; answer only when >= 7 of 8 samples agree (v7: best public PA 0.084).
# MALT_EARLY_STOP stops a question once the remaining samples cannot change the outcome.
_default MALT_SAMPLES 8
_default MALT_MIN_AGREEMENT 0.875
_default MALT_EARLY_STOP true
# lists (-0.37 on dev1000) and booleans (0.0) must be unanimous
_default MALT_TYPE_GATES '{"list": 1.0, "boolean": 1.0}'

# the JSON bodies below are read by src/config.py; presence_penalty 1.5 stops the thinking loops
_default LLM_EXTRA_BODY '{"chat_template_kwargs": {"enable_thinking": false}}'
_default ANALYZE_EXTRA_BODY '{"chat_template_kwargs": {"enable_thinking": true}, "presence_penalty": 1.5}'
