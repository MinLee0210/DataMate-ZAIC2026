# app (debug API: make run, and logging)
APP_NAME=datamate
APP_VERSION=0.1.0
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=false
LOG_LEVEL=INFO

# dev_free: a hosted model (OpenAI-compatible), train data only.
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com, LLM_MODEL=deepseek-flash,
#           LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
# OpenRouter, target model:
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3-14b
# OpenRouter: pin one provider (no silent fallback) and turn off reasoning, for reproducibility
LLM_EXTRA_BODY={"provider": {"allow_fallbacks": false, "require_parameters": true}, "reasoning": {"enabled": false}}
# stream replies so time to first token is measured (same output either way)
LLM_STREAM=true

# dev_constraint / final: local vLLM (make vllm). FINAL_MODE=1 refuses any non-local URL.
# LLM_BASE_URL=http://127.0.0.1:8001/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=Qwen/Qwen3-14B
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
# FINAL_MODE=1

# local paths (defaults are the competition mounts /data and /result)
DATA_DIR=./data
RESULT_DIR=./result
WORK_DIR=/tmp/datamate
SPLIT=train

# pipeline: "malt" (dataAgent, the reasoning loop) or "vote" (k SQL candidates + vote)
PIPELINE=malt
# thinking for the reasoning steps, merged over LLM_EXTRA_BODY. DeepSeek:
# ANALYZE_EXTRA_BODY={"thinking": {"type": "enabled"}}
# vLLM Qwen3: ANALYZE_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": true}}
ANALYZE_EXTRA_BODY=
ANALYZE_MAX_TOKENS=16384
# questions answered in parallel by python -m src and make eval
WORKERS=1

# vote pipeline only
K=3
TAU=0.67

# scripts/datagen only (never used by src/): teacher model for synthetic train data
OPENROUTER_API_KEY=
DATAGEN_MODEL=openai/gpt-5.5

# experiment tracking, dev only (scripts/devfree/wandb_report.py): set the key in .env, never here
WANDB_API_KEY=
